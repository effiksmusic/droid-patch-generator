        ], "Button for switching the mode of the faders" )

    else:
        parameters = []
        nr = 1
        for mode, b in menu_buttons:
            parameters += [
                ( "button%d" % nr, "B" + b ),
                ( "led%d" % nr, "L" + b ),
                ( "value%d" % nr, mode ),
            ]
            nr += 1
        clear_sources = []

        if have_fadermode_buttons():
            if root_button:
                # In the root sequencer menu the fader mode buttons
                # switch between root note and scale, so they must not
                # close the menu.
                patch += circuit("copy", [
                    ( "input", "1 - L%s" % root_button ),
                    ( "output", "_NOT_ROOT_MENU" ),
                ], "Is a menu other than the root sequencer active?")
                clear_sources.append("_FADERMODE_CHANGED * _NOT_ROOT_MENU")
            else:
                clear_sources.append("_FADERMODE_CHANGED")

        # While the root sequencer is selected, a press on any track
        # button switches back to the sequence of that track.
        if root_button and arguments["tracks"] > 1:
            presses = "_TRACK_BUTTON_PRESS"
            if num_button_pages() >= 2:
                patch += circuit("mixer", [
                    ( "input1", "_TRACK_BUTTON_PRESS" ),
                    ( "input2", "_TRACK_EXTRA_PRESS" ),
                    ( "output", "_TRACK_ANY_PRESS" ),
                ], "Any press on a track button, no matter whether the "
                   "selected track changes")
                presses = "_TRACK_ANY_PRESS"
            clear_sources.append("%s * L%s" % (presses, root_button))

        if len(clear_sources) > 1:
            # Every input is of the form A * B + C, so two products
            # need a mixer of their own.
            patch += circuit("mixer", [
                ( "input%d" % (nr + 1), source )
                for nr, source in enumerate(clear_sources) ] + [
                ( "output", "_MENU_CLEAR" ),
            ], "All reasons for leaving the current menu")
            clear_args = [ ( "clear", "_MENU_CLEAR" ) ]
        elif clear_sources:
            clear_args = [ ( "clear", clear_sources[0] ) ]
        else:
            clear_args = []

        if have_root_sequencer():
            patch += circuit("multicompare", [
                ( "input", "_GLOBAL_MENU" ),
                ( "compare1", RS_MENU ),
                ( "ifequal1", RS_TRACK_MENU ),
                ( "compare2", RS_TRACK_MENU ),
                ( "ifequal2", RS_TRACK_MENU ),
                ( "else", selected_track + "+ 10" ),
                ( "output", "_TRACK_MENU_SELECTION" ),
            ], "While the root sequencer is selected, the TRK button "
               "leads to its parameters instead of the track menu")

        patch += circuit("buttongroup", parameters + clear_args + [
            ( "display", 0 ),
            ( "startbutton", 0 ),
            ( "minactive", 0 ),
            ( "maxactive", 1 ),
            ( "output", "_GLOBAL_MENU" ),
        ], "Select a global menu function of the faders. There is no "
           "button for \"normal\" in order to save buttons. Simply "
           "press the currently lit button to deactivate all menu "
           "buttons and go back to controlling the sequence. ")

        patch += circuit("ifequal", [
            ( "input1", "_GLOBAL_MENU" ),
            ( "input2", 0 ),
            ( "ifequal", selected_track ),
            ( "else", "_GLOBAL_MENU" ),
            ( "output", "_GLOBAL_FADER_SELECTION" ),
        ], "If there is no menu active, the fader edit the sequence "
           "of the currently selected track.")

    return patch


def track_section(track):
    patch = section_header("Track %d" % track)

    tracksel = [
        ("select", "_GLOBAL_FADER_SELECTION" ),
        ("selectat", track_selectat(track) )]

    # Clear button (long press)
    if arguments["clear"]:
        b = track_buttons["clear"]
        patch += circuit("button", track_selected(track) + [
            ( "button", "B" + b ), #  + "* _CONTROL" ),
            ( "shortpress", "_T%d_CLEAR_BUTTON" % track),
            ( "states", 1 ),
        ], "Provide trigger when the clear button is pressed (no Ctrl needed)")

        patch += circuit("copy", [
            ( "input", "_T%d_CLEAR_BUTTON * _CONTROL" % track ),
            ( "output", "_T%d_CLEAR" % track ),
        ], "Clear button with control together clears the track" )

        patch += circuit("logic", [
            ( "input1", "_T%d_CLEAR_BUTTON" % track ),
            ( "input2", "1 - _CONTROL" ),
            ( "and", "_T%d_PEACE" % track ),
        ], "Clear button without control removes all mode that alter the pattern length" )

        patch += circuit("burst", [
            ( "trigger", "_T%d_CLEAR + _FACTORY_RESET" % track ),
            ( "hz", 5 ),
            ( "count", 5 ),
            ( "output", "_T%d_CLEAR_LED" % track ),
        ], "Five blinks for the clear LED")

        patch += circuit("select", track_selected(track) + [
            ( "input", "_T%d_CLEAR_LED + 0.3" % track ),
            ( "output", "L" + b ),
        ], "LED only blinks when track is selected")

    # Reset track to step 1
    if arguments["rb"]:
        patch += circuit("button", track_selected(track) + [
            ( "button", "B" + track_buttons["reset"] + " * _NO_CONTROL" ),
            ( "states", 1 ),
            ( "output", "_T%d_RESET" % track ),
        ], "Reset track immediately" )
        patch += display_event("_T%d_RESET" % track,
            "Reset track" if sync_sections() else "Reset track %d" % track)

    # Copy & paste
    if arguments["copy"] != "off":
        if arguments["copy"] == "copypaste" and num_pages() == 1:
            bail_out("Copy & paste does not work nor make sense if you "
                     "have %d steps and %d faders. It only works if you "
                     "have more steps than faders and "
                     "thus buttons for switching pages." % (num_steps(), num_faders()))

        patch += circuit("button", track_selected(track) + [
            ( "button", "B" + track_buttons["copy"] ),
            ( "states", 1 ),
            ( "output", "_T%d_COPY_BUTTON" % track ),
        ], "Button for copy and paste" )


    # Form button
    if arguments["form"]:
        b = track_buttons["form"]
        button = "B" + b

        patch += circuit("button",
            track_selected(track) +
            clear_on_clear_arguments(track) +
            track_preset_params(track) + [
            ( "button", "B" + b ),
            ( "led", "L" + b ),
            ( "output", "_T%d_FORM" % track),
            ( "states", 3 ),
        ], "This button cycles between the song froms A, AAAB and AABB")

    # Disable quantization
    if arguments["bq"]:
        b = track_buttons["bq"]
        button = "B" + b

        patch += circuit("button",
            track_selected(track) +
            track_preset_params(track) + [
            ( "button", "B" + b ),
            ( "led", "L" + b ),
            ( "output", "_T%d_12TONE" % track),
        ], "Disables scale and note selection if on")

    # Transpose by root note
    if arguments["tbr"]:
        patch += circuit("button",
            track_selected(track) +
            track_preset_params(track) + [
            ( "button", "B" + track_buttons["tbr"] ),
            ( "led", "L" + track_buttons["tbr"] ),
            ( "startvalue", 1 if arguments["tbron"] else 0 ),
            ( "output", "_T%d_TBR_ON" % track ),
            ( "inverted", "_T%d_TBR_OFF" % track ),
        ], "Enable transposing the melody by the difference of the root note to C" )

        patch += circuit("ifequal", [
            ( "input1", "_T%d_TBR_ON" % track ),
            ( "input2", 1 ),
            ( "ifequal", "_ROOT / 120" ),
            ( "output", "_T%d_TBR" % track ),
        ], "Provide the amount of 'transpose by root' in a patch cable")

        patch += display_list_choice([
            "don't transpose",
            "transpose",
            ], "_T%d_TBR_ON" % track,
            header = "Transpose by root")

    # Lucky faders / buttons
    if have_two_lucky_buttons():
        patch += circuit("button", track_selected(track) + [
            ( "button", "B" + track_buttons["lucky"] ),
            ( "states", 1 ),
            ( "onvalue", "_LUCKY_CLOCK" ),
            ( "output", "_T%d_LUCKY_FADERS" % track ),
        ], "Hold to continously step the faders to random positions" )

        patch += circuit("button", track_selected(track) + [
            ( "button", "B" + track_buttons["luckygates"] ),
            ( "states", 1 ),
            ( "onvalue", "_LUCKY_CLOCK" ),
            ( "output", "_T%d_LUCKY_GATES" % track ),
        ], "Hold to continously set the gates at random" )

        patch += display_event("_T%d_LUCKY_FADERS" % track, "I feel lucky!")
        patch += display_event("_T%d_LUCKY_GATES" % track, "Lucky gates!")

    elif arguments["lucky"]:
        patch += circuit("button", track_selected(track) + [
            ( "button", "B" + track_buttons["lucky"] ),
            ( "states", 1 ),
            ( "onvalue", "_LUCKY_CLOCK" ),
            ( "output", "_T%d_LUCKY" % track ),
        ], "Hold to contiously step faders to random positions, hold with Ctrl to change buttons" )

        patch += display_event("_T%d_LUCKY * _NO_CONTROL" % track, "I feel lucky!")
        patch += display_event("_T%d_LUCKY * _CONTROL" % track, "Lucky gates!")

    if arguments["inv"]:
        b = track_buttons["inv"]
        button = "B" + b

        patch += circuit("button",
            track_selected(track) +
            clear_on_clear_arguments(track) +
            track_preset_params(track) + [
            ( "button", "B" + b ),
            ( "led", "L" + b ),
            ( "output", "_T%d_INVERT" % track),
        ], "Selects melodic inversion (swap low and high notes)")

        patch += display_list_choice([
            "don't invert",
            "invert pitches",
        ], "_T%d_INVERT" % track,
            header = "Pitch inversion")


    patch += track_menu(track)
    if arguments["arp"]:
        patch += arpeggio_menu(track)

    patch += track_presets(track)

    bgroupargs = track_selected(track)  + [
        ( "minactive", 1 ),
        ( "maxactive", "_CONTROL * -6 + 7" ),
        ( "startbutton", -1 ),
    ]
    for b in range(1, 8):
        bgroupargs += [
            ( "button%d" % b, "B%d.%d" % (notesel_position, b) ),
            ( "led%d" % b, "L%d.%d" % (notesel_position, b) ),
            ( "buttonoutput%d" % b, "_T%d_SEL_%d" % (track, b)),
        ]
    patch += circuit("buttongroup", bgroupargs,
        "Select which notes from the current scale should be played")


    # Compute clock for this track
    patch += circuit("clocktool", [
        ( "clock", "_CLOCK" ),
        ( "reset", "_RESET" ),
        ( "divide", "_T%d_CD_EVEN_DIV * _T%d_CD_ODD_DIV" % (track, track)),
        ( "multiply", "_T%d_CD_EVEN_MULT * _T%d_CD_ODD_MULT" % (track, track)),
        ( "output", "_T%d_CLOCK" % track)
    ], "Clock divider for track %d" % track)


    if num_button_pages() > 1:
        paging = [ ( "page", "_PAGE" ) ]
    else:
        paging = []

    if arguments["copy"] == "copypaste":
        paging += [
            ( "copy", "_T%d_COPY_BUTTON * _NO_CONTROL" % track ),
            ( "paste", "_T%d_COPY_BUTTON * _CONTROL" % track ),
        ]
    else:
        if arguments["copy"] in [ "stepcopy", "dual" ]:
            paging.append(( "stepcopy", "_T%d_COPY_BUTTON" % track ))
        if arguments["copy"] in [ "doublerange", "dual" ]:
            paging.append(( "doublerange", "_T%d_COPY_BUTTON" % track ))
            if not arguments["range"]:
                bail_out("The feature \"double the range\" does not work if you have "
                         "not activated the step parameter \"Set range of steps to play\".")

    gate = "_T%d_SEQUENCER_GATE" % track # here comes our gate

    clock = "_T%d_CLOCK" % track
    if have_running():
        clock += " * _RUNNING"

    if arguments["rb"]:
        extra_reset = " + _T%d_RESET" % track
    else:
        extra_reset = ""

    # Diatonic transposition (noteshift)
    patch += circuit("mixer", [
        ( "input1", "_T%d_NOTESHIFT_CLOCKED" % track ),
        ( "input2", "_GLOBAL_NOTESHIFT_CLOCKED" ),
        ( "output", "_T%d_NOTESHIFT_SUM" % track ),
    ], "Mix global and per-track diatonic transposition" )

    # The actual motoquencer circuit
    params = \
        tracksel +  \
        paging + \
        track_preset_params(track) + \
        clear_on_clear_arguments(track) + \
        track_note_selects(track, False) + [
        ( "degree", "_DEGREE" ),
        ( "clock", clock ),
        ( "taptempo", "_T%d_CLOCK" % track ),
        ( "reset", "_RESET" + extra_reset ),
        ( "cv", "_T%d_PITCH" % track ),
        ( "cvrange", "_T%d_CVRANGE * 1V" % track ),
        ( "defaultgate", arguments["defgate"] ),
        ( "gate", gate ),
        ( "numfaders", num_faders()),
        ( "numsteps", num_steps()),
    ] + default_end_step() + [
        ( "linktonext", 1 if (has_velocity_layer(track) or arguments["act"]
                              or arguments["gl"]) else 0),
        ( "autoreset", "_T%d_AUTORESET" % track),
        ( "shiftsteps", "_T%d_SHIFTSTEPS" % track),
        ( "pattern", "_T%d_PATTERN_FADER - 2" % track),
        ( "direction", "_T%d_DIRECTION" % track),
        ( "pingpong", "_T%d_PINGPONG" % track),
        ( "selectnoteshift", "_T%d_NOTESHIFT_SUM" % track ),
        ( "tuningmode", "_TUNINGMODE" ),
        ( "tuningpitch", "1V" ),
        ( "bulkedit", "_CONTROL" ),
    ]
    if button_repeats:
        params.append(( "constantlength", "B" + button_repeats ))

    if arguments["randpitch"]:
        if arguments["intclk"]:
            params += [ ( "accumulatorrange", "_T%d_ACCU_RANGE" % track ) ]
        else:
            params += [ ( "accumulatorrange", 4 ) ]


    if arguments["tbr"]:
        params += [
            ( "root", "_ROOT * _T%d_TBR_OFF" % track ),
            ( "transpose", "_T%d_TBR" % track ),
        ]
    else:
        params.append(( "root", "_ROOT" ))


    if arguments["lucky"]:
        params += [
            ( "luckybuttons", "_T%d_LUCKY_GATES" % track
                              if have_two_lucky_buttons()
                              else "_T%d_LUCKY * _CONTROL" % track ),
            ( "luckyfaders", "_T%d_LUCKY_FADERS" % track
                             if have_two_lucky_buttons()
                             else "_T%d_LUCKY * _NO_CONTROL" % track ),
            ( "luckychance", "1/%d" % num_faders() ),
            ( "luckyamount", "0.5 * _NO_CONTROL + 0.5" ),
        ] + ([ ( "luckycvbase", "_T%d_LUCKY_CVBASE" % track ) ]
             if have_lucky_base() else []) + [
            ( "luckyscope", 3 ),
        ]

    if have_fadermode_buttons():
        params.append(( "fadermode", "_FADERMODE" ))

    if have_running():
        params.append(( "mute", "1 - _RUNNING" ))

    if arguments["form"]:
        params.append(("form", "_T%d_FORM" % track))

    if arguments["inv"]:
        params.append(("invert", "_T%d_INVERT" % track))

    if arguments.get("sos%d" % track):
        params.append(("startofsequence", gate_outputs["sos1"]))

    if arguments["gl"]:
        params.append(( "gatelength", "_T%d_GATELENGTH" % track ))

    params.append(("buttonmode", "_BUTTONMODE"))

    prefix = "B%d." % notesel_position
    labels[prefix + "1"] = ( "ROOT", "Allow root note" )
    labels[prefix + "2"] = ( "3RD", "Allow third note" )
    labels[prefix + "3"] = ( "5TH", "Allow fifth note" )
    labels[prefix + "4"] = ( "7TH", "Allow seventh note" )
    labels[prefix + "5"] = ( "9TH", "Allow nineth note" )
    labels[prefix + "6"] = ( "11TH", "Allow eleventh note" )
    labels[prefix + "7"] = ( "13TH", "Allow thirtheenth note" )

    if need_control_button():
        labels[prefix + "8"] = ( "CTRL", "Switch some of the button functions" )

    params.append(("composemode", "_COMPOSEMODE"))

    if clear_on_peace(track):
        if arguments["range"]:
            clearstartend = "_T%d_CLEARSTARTEND" % track
            if arguments["tracks"] > 1:
                patch += circuit("ifequal", [
                    ( "input1", "_SELECTED_TRACK * _RANGE" ),
                    ( "input2", track_selectat(track) ),
                    ( "ifequal", 1 ),
                    ( "output", "_T%d_CLEAR_RANGE" % track ),
                ], "The clear range logic should just affect the current track")
                patch += circuit("logic", [
                    ( "input1", clear_on_peace(track) ),
                    ( "input2", "_T%d_CLEAR_RANGE * _CONTROL" % track ),
                    ( "or", clearstartend ),
                ], "Collect different sources of resetting the start/end point")
            else:
                patch += circuit("logic", [
                    ( "input1", clear_on_peace(track) ),
                    ( "input2", "_RANGE * _CONTROL" ),
                    ( "or", clearstartend ),
                ], "Collect different sources of resetting the start/end point")

        else:
            clearstartend = clear_on_peace(track)
        params += [
            ( "clearskips", clear_on_peace(track) ),
            ( "clearrepeats", clear_on_peace(track) ),
            ( "clearstartend", clearstartend ),
        ]

    if arguments["skiprep"]:
        if arguments["cn"] == "d":
            patch += circuit("logic", [
                ( "input1", track_select_argument(track, False) ),
                ( "input2", "_T%d_ARP_OFF" % track if arguments["arp"] else 1 ),
                ( "and", "_T%d_ENC_1_SELECTED" % track ),
            ], "Select encoder if track %d is selected, arp is off and control is not held" % track)

            patch += circuit("encoder", [
                ( "select", "_T%d_ENC_1_SELECTED" % track ),
                ( "encoder", 1 ),
                ( "header", '"Repeat shift"' ),
                ( "color", 0.6 ),
                ( "discrete", 15 ),
                ( "startvalue", 7 ),
                ( "outputoffset", -7 ), # -7 ... 7
                ( "output", "_T%d_REPEATSHIFT" % track ),
            ], "Note shift for each step repetition")
        else:
            patch += circuit("pot", track_and_nonarp_selected(track) + [
                    ( "pot", pots["repeat_note_shift"] ), # upper pot
                    ( "discrete", 15 ), # -7 ... 7
                    ( "startvalue", 7 ),
                    ( "outputoffset", -7 ), # -7 ... 7
                    ( "output", "_T%d_REPEATSHIFT" % track ),
            ], "Note shift for each step repetition")
        params.append(( "repeatshift", "_T%d_REPEATSHIFT" % track))

    if arguments["ratchets"]:
        if arguments["cn"] == "d":
            patch += circuit("logic", [
                ( "input1", track_select_argument(track, True) ),
                ( "input2", "_T%d_ARP_OFF" % track if arguments["arp"] else 1 ),
                ( "and", "_T%d_ENC_2_SELECTED" % track ),
            ], "Select encoder if track %d is selected, arp is off and control is held" % track)

            patch += circuit("encoder", [
                ( "select", "_T%d_ENC_2_SELECTED" % track ),
                ( "encoder", 1 ),
                ( "header", '"Ratchet shift"' ),
                ( "color", 0.8 ),
                ( "discrete", 15 ), # -7 ... 7
                ( "startvalue", 7 ),
                ( "outputoffset", -7 ), # -7 ... 7
                ( "output", "_T%d_RATCHETSHIFT" % track ),
            ], "Note shift for each ratchet")
        else:
            patch += circuit("pot", track_and_nonarp_selected(track) + [
                ( "pot", pots["ratchet_note_shift"] ), # lower pot
                ( "discrete", 15 ), # -7 ... 7
                ( "startvalue", 7 ),
                ( "outputoffset", -7 ), # -7 ... 7
                ( "output", "_T%d_RATCHETSHIFT" % track ),
            ], "Note shift for each ratchet")
        params.append(( "ratchetshift", "_T%d_RATCHETSHIFT" % track))

    if arguments["arp"]:
        params.append(( "startofsequence", "_T%d_START_OF_SEQUENCE" % track))

    patch += quencer_circuit(params, "Sequencer for pitch and gate of track %d" % track)

    # Allocate CV ouputs
    if track_is_cvgate(track):
        if is_chord_track(track):
            # Four voices instead of one
            chord_output_jacks = [
                get_cv_output("Chord %d.%d" % (track, voice),
                              "Voice %d of the chord of track %d"
                              % (voice, track))
                for voice in range(1, num_chord_voices() + 1) ]
            pitch_output_jack = None
        else:
            pitch_output_jack = get_cv_output(
                "V/O %d" % track,
                "Pitch CV output track %d" % track)

        if velocity_has_cv_output(track):
            velo_output_jack = get_cv_output(
                "Velo %d" % track,
                "Modulation CV output track %d" % track)

        if arguments["velo"] in [ "vg", "g" ]:
            extragate_output_jack = gate_outputs["xgate%d" % track]

    # Linked sequencer for extra CV --------------------------
    if has_velocity_layer(track):
        gate_params = []
        default_cv = 0.5

        # The extra gate brings its own notches, otherwise the second
        # layer is continuous - except on the chord track, where it
        # carries the harmonic shift in eight steps.
        if arguments["velo"] != "g":
            gate_params.append(( "cvnotches", "_T%d_CVNOTCHES" % track
                                 if sync_sections() else
                                 ( 8 if is_chord_track(track) else 0 ) ))

        # With synced sections and without a CV output the sequencer
        # writes to a cable, so that the jacks stay out of the section.
        if track_is_midi(track) or sync_sections() \
             or (arguments["velo"] != "g"
                 and not velocity_has_cv_output(track)):
            if arguments["velo"] == "g": # Use the CV as extra gate
                out = "_T%d_EXTRAGATE" % track
            else:
                out = "_T%d_VELOCITY" % track
        elif arguments["velo"] == "g":
            out = extragate_output_jack
        else:
            out = velo_output_jack

        if arguments["velo"] == "vg":
            gate_params += [
                ( "gate", "_T%d_EXTRAGATE" % track
                             if (track_is_midi(track) or sync_sections())
                             else extragate_output_jack ),
                ( "buttoncolor", COLOR_EXTRAGATES ),
                ( "gatelength", 0.99 ),
            ]
            extra_comment = " and extra gate"
        elif arguments["velo"] == "g":
            gate_params.append(( "cvnotches", 2 ))
            extra_comment = " (used as extra gate)"
            default_cv = 1

        else:
            extra_comment = ""

        velomin = arguments["velomin"] * 0.001
        velomax = arguments["velomax"] * 0.001
        if velomin > velomax:
            bail_out(("You've set the minimum velocity (%.3f V) higher than the "
                     "maximum velocity (%.3f V). This is not allowed.") % (
                     velomin, velomax))
        elif velomin == velomax:
            bail_out(("You've set the minimum and the maximum velocity both to the same "
                      "value of (%.3f V) This is not allowed.") % velomax)

        patch += quencer_circuit(
            tracksel + \
            paging + \
            clear_on_clear_arguments(track) + \
            track_preset_params(track) + \
            gate_params + \
            [
                ( "cv", out ),
                ( "defaultcv", "%.3fV" % ((velomax + velomin) / 2) ),
                ( "cvbase", "_T%d_LAYER_BASE" % track if sync_sections()
                            else second_layer_range(track)[0] ),
                ( "cvrange", "_T%d_LAYER_RANGE" % track if sync_sections()
                             else second_layer_range(track)[1] ),
                ( "quantize", 0 ),
                ( "cvname", '"Velocity"' ),
                ( "bulkedit", "_CONTROL" ),
                ( "linktonext", 1 if (arguments["act"] or arguments["gl"]) else 0),
            ], "Sequencer for velocity" + extra_comment )

        if (track_is_midi(track) or sync_sections()) \
           and track_is_cvgate(track) \
           and not is_chord_track(track):
            # The extra gate is a gate and always needs a jack. The
            # velocity only gets one if it is not MIDI only.
            if arguments["velo"] == "g": # the CV is the extra gate
                patch += defer("Track outputs", circuit("copy", [
                    ( "input", out ),
                    ( "output", extragate_output_jack ),
                ], "Copy extra gate to CV output" ))

            elif velocity_has_cv_output(track):
                patch += defer("Track outputs", circuit("copy", [
                    ( "input", out ),
                    ( "output", velo_output_jack ),
                ], "Copy velocity to CV output" ))

            if arguments["velo"] == "vg":
                patch += defer("Track outputs", circuit("copy", [
                    ( "input", "_T%d_EXTRAGATE" % track ),
                    ( "output", extragate_output_jack ),
                ], "Copy extra gate to CV output" ))

    if has_velocity_layer(track) and velocity_goes_nowhere(track) \
       and arguments["velo"] in ( "v", "vg" ):
        # This belongs to the outputs, so that the track sections stay
        # identical no matter where the velocity of a track goes.
        patch += defer("Track outputs", circuit("copy", [
            ( "input", "_T%d_VELOCITY" % track ),
        ], "The velocity of this track is not sent anywhere"))

    # Linked sequencer for gate length and glide ----------------
    if arguments["gl"]:
        patch += quencer_circuit(
            tracksel + \
            paging + \
            clear_on_clear_arguments(track) + \
            track_preset_params(track) + \
            [
                ( "cv", "_T%d_GATELENGTH" % track ),
                ( "cvbase", 0.05 ), # minimal gate length
                ( "cvrange", 0.9 ), # maximum gate length is 0.95
                ( "defaultcv", 0.5 ),
                ( "defaultgate", 0 ), # NO glide
                ( "quantize", 0 ),
                ( "buttoncolor", COLOR_GLIDES ),
                ( "cvname", '"Gate length"' ),
                ( "bulkedit", "_CONTROL" ),
                ( "linktonext", 1 if arguments["act"] else 0),
            ] + ([("gate", "_T%d_GLIDE" % track ),
                  ("gatename", '"Glide"') ] if track_is_cvgate(track) else []),

        "Sequencer for gate length and glide" )

    # Linked sequencer for activity ----------------------------
    if arguments["act"]:
        patch += quencer_circuit(
            tracksel + \
            clear_on_clear_arguments(track) + \
            track_preset_params(track) + \
            [
                ( "cv", "_T%d_STEP_ACTIVITY" % track ),
                ( "quantize", 0 ),
                ( "defaultcv", 7 ),
                ( "cvname", '"Activity"' ),
                ( "cvnotches", 8 ),
                ( "bulkedit", "_CONTROL" ),
            ]
        , "Sequencer for activity level per step")

        patch += circuit("compare", [
            ( "input", "_T%d_STEP_ACTIVITY" % track ),
            ( "compare", "_T%d_ACTIVITY" % track ),
            ( "ifless", 0 ),
            ( "else", gate ),
            ( "output", "_T%d_ACT_GATE" % track ),
        ], "Silence the gate if the step does not reach the required activity" )
        gate = "_T%d_ACT_GATE" % track

    # Switch gate to arpeggiator if active ---------------------
    if arguments["arp"]:
        if arguments["gl"]:
            gatelength = "_T%d_GATELENGTH" % track
        else:
            gatelength = 0.5

        arp_gate = "_T%d_ARP_MODULATED_GATE" % track
        patch += circuit("gatetool", [
            ( "taptempo", "_T%d_ARP_TAPTEMPO" % track ),
            ( "gatelength", gatelength ),
            ( "inputgate", "_T%d_ARP_CLOCK" % track ),
            ( "outputgate", arp_gate ),
        ], "Modulate gate length for gate output in arpeggiator mode" )

        patch += circuit("ifequal", [
            ( "input1", "_T%d_ARP_SYNCED" % track ),
            ( "input2", 0 ),
            ( "ifequal", gate ),
            ( "else", arp_gate ),
            ( "output", "_T%d_SWITCHED_GATE" % track ),
        ], "Switch gate to arpeggiator if active" )
        gate = "_T%d_SWITCHED_GATE" % track

    # Mute logic -----------------------------------------------
    patch += circuit("logic", [
        ( "input1", "1 - _T%d_MUTED" % track ),
        ( "input2", gate ),
        ( "and", "_T%d_MUTED_GATE" % track ),
    ], "Logic for make the gate silent if the track is muted")
    gate = "_T%d_MUTED_GATE" % track

    if arguments["arp"]:
        patch += track_arpeggiator(track)

    # Switch pitch between sequencer and arpeggio
    if arguments["arp"]:
        patch += circuit("ifequal", [
            ( "input1", "_T%d_ARP_SYNCED" % track ),
            ( "input2", 0 ),
            ( "ifequal", "_T%d_PITCH" % track ), # sequencer
            ( "else", "_T%d_ARP_OUTPUT + _T%d_ARP_OCTAVE" % (track, track )), # arpeggio
            ( "output", "_T%d_SWITCHED_PITCH" % track ),
        ], "Switch pitch output between sequencer and arpeggiator" )
        pitch_from_sequencer = "_T%d_SWITCHED_PITCH" % track
    else:
        pitch_from_sequencer = "_T%d_PITCH" % track


    # Mixer for all that consitues the final pitch
    pitch_mixes = [
        ( "input1", "_T%d_OCTAVE * 1V - 2V" % track ),
        ( "input2", pitch_from_sequencer ),
        ( "input3", "_GLOBAL_OCTAVE_SWITCH * 1V - 2V" ),
        ( "input4", "_GLOBAL_TRANSPOSITION * 0.00833333" ) ]

    if "transpose" in cv_inputs:
        pitch_mixes.append(( "input5", cv_inputs["transpose"] ))

    if arguments["sinflink"] != "off":
        pitch_mixes.append(( "input6", "_SINFLINK_TRANSPOSE" ))

    patch += circuit("mixer", pitch_mixes + [
        ( "output", "_T%d_FINAL_PITCH" % track ),
    ], "Mix all sources of pitch together" )

    if track_is_cvgate(track) and is_chord_track(track):
        pitch = "_T%d_FINAL_PITCH" % track
        if arguments["gl"]:
            patch += defer("Track outputs", circuit("slew", [
                ( "input", pitch ),
                ( "exponential", "_T%d_CHORD_PITCH" % track ),
                ( "slew", "_T%d_GLIDE * _T%d_GLIDE_LENGTH" % (track, track) ),
            ], "Slew limiter for glides" ))
            pitch = "_T%d_CHORD_PITCH" % track

        patch += defer("Track outputs", circuit("chord", [
            ( "pitch", pitch ),
            ( "root", "_ROOT * _T%d_TBR_OFF" % track
                      if arguments["tbr"] else "_ROOT" ),
            ( "degree", "_DEGREE" ),
            ( "harmonicshift", "_T%d_VELOCITY" % track ),
        ] + [ # the same note selection buttons that the track uses
              ( "select%d" % (2 * nr - 1), "_T%d_SEL_%d" % (track, nr) )
              for nr in range(1, 8) ]
          + [ ( "selectfill%d" % nr, 0 ) for nr in range(1, 6) ]
          + [
            ( "tuningmode", "_TUNINGMODE" ),
            ( "tuningpitch", "1V" ),
            ( "spread", "1V" ),
        ] + [ ( "output%d" % voice, chord_output_jacks[voice - 1] )
              for voice in range(1, num_chord_voices() + 1) ],
           "%d voices of the chord of track %d"
           % (num_chord_voices(), track)))

    elif track_is_cvgate(track):
        if arguments["gl"]:
            patch += defer("Track outputs", circuit("slew", [
                ( "input", "_T%d_FINAL_PITCH" % track ),
                ( "exponential", pitch_output_jack ),
                ( "slew", "_T%d_GLIDE * _T%d_GLIDE_LENGTH" % (track, track) ),
            ], "Slew limiter for glides" ))
        else:
            patch += defer("Track outputs", circuit("copy", [
                ( "input", "_T%d_FINAL_PITCH" % track ),
                ( "output", pitch_output_jack ),
            ], "Copy final pitch to CV output"))

    # Final output of the gate
    gate_jack = "_T%d_FINAL_GATE" % track

    # Start/Stop button needs to mute the gate because of the
    # arpeggiator (it has no gate)
    if have_running():
        if arguments["arp"]:
            patch += circuit("ifequal", [
                ( "input1", "_T%d_ARP" % track ),
                ( "input2", 0 ),
                ( "ifequal", "_RUNNING + _COMPOSEMODE" ),
                ( "else", "_RUNNING" ),
                ( "output", running_or_compose(track)),
            ],
            "If we are in compose mode and the arpeggiator is switched "
            "off, the gate is output even if the sequencer is stopped.")
        else:
            patch += circuit("copy", [
                ( "input", "_RUNNING + _COMPOSEMODE" ),
                ( "output", running_or_compose(track)),
            ],
            "If we are in compose mode the gate is output even if the sequencer is stopped.")
        gate = gate + " * " + running_or_compose(track)



    patch += circuit("copy", [
        ( "input", gate ),
        ( "output", "_T%d_FINAL_GATE" % track ),
    ], "Copy the gate to its final destination" )

    if track_is_cvgate(track):
        patch += defer("Track outputs", circuit("copy", [
            ( "input", "_T%d_FINAL_GATE" % track ),
            ( "output",  gate_outputs["gate%d" % track] ),
        ], "Copy the gate signal to the CV jack"))


    if have_display():
        if arguments["form"]:
            patch += display_list_choice([
                "a",
                "a a a c",
                "a a c c"],
                "_T%d_FORM" % track,
                "_T%d_FORM_NAME" % track,
                "Song form",
                fontsize = 4)

        if arguments["bq"]:
            patch += display_list_choice([
                "diatonic",
                "chromatic" ],
                "_T%d_12TONE" % track,
                "_T%d_12TONE_NAME" % track,
                "Scale",
                fontsize = 2)

        if arguments["clear"]:
            if arguments["range"]:
                patch += display_event("_T%d_CLEARSTARTEND" % track, "Reset start/end")
            # A text is a real parameter, not a comment, so it has to
            # read the same in every track section.
            if sync_sections():
                patch += display_event("_T%d_PEACE" % track, "Track peace")
                patch += display_event("_T%d_CLEAR" % track, "Track cleared")
            else:
                patch += display_event("_T%d_PEACE" % track, "Track %d peace" % track)
                patch += display_event("_T%d_CLEAR" % track, "Track %d cleared" % track)

        if arguments["arp"]:
            patch += display_list_choice(
               [ "Sequencer", "Arpeggiator" ],
                 "_T%d_ARP" % track)


    return patch

def track_arpeggiator(track):
    patch = ""

    patch += circuit("switch", [
        ( "input1", "_CLOCK" ),
        ( "input2", "_T%d_SEQUENCER_GATE" % track ),
        ( "input3", "_CLOCK_3_2" ),
        ( "input4", "_CLOCK_2_1" ),
        ( "input5", "_CLOCK_3_1" ),
        ( "input6", "_CLOCK_4_1" ),
        ( "input7", "_CLOCK_6_1" ),
        ( "input8", "_CLOCK_8_1" ),
        ( "output", "_T%d_ARP_CLOCK" % track),
        ( "offset", "_T%d_ARP_CLOCKING" % track),
    ], "Select clock for arpeggiator of track %d. It is either the master "
       "clock or a multiplication of it, or the sequencer gate output. " % track)

    patch += circuit("switch", [
        ( "input1", "_CLOCK" ),
        ( "input2", "_T%d_CLOCK" % track ),
        ( "input3", "_CLOCK_3_2" ),
        ( "input4", "_CLOCK_2_1" ),
        ( "input5", "_CLOCK_3_1" ),
        ( "input6", "_CLOCK_4_1" ),
        ( "input7", "_CLOCK_6_1" ),
        ( "input8", "_CLOCK_8_1" ),
        ( "output", "_T%d_ARP_TAPTEMPO" % track),
        ( "offset", "_T%d_ARP_CLOCKING * _T%d_ARP" % (track, track)),
    ], "Create taptempo for arp clock to be used for gate length")

    # Pitch base and range are on overlayed pots
    if arguments["cn"] == "d":
        patch += circuit("logic", [
                ( "input1", track_select_argument(track, False) ),
                ( "input2", "_T%d_ARP" % track ),
                ( "and", "_T%d_ENC_3_SELECTED" % track ),
        ], "Select encoder if track %d is selected, arp is on and control is not held" % track)

        patch += circuit("encoder", [
            ( "encoder", 1 ),
            ( "select", "_T%d_ENC_3_SELECTED" % track ),
            ( "header", '"Arp base pitch"' ),
            ( "color", 0.2 ),
            ( "discrete", 37 ),
            ( "sensivity", 3 ),
            ( "output", "_T%d_ARP_PITCH" % track ),
        ], "Encoder for base pitch of arpeggiator" )

        patch += circuit("logic", [
                ( "input1", track_select_argument(track, True) ),
                ( "input2", "_T%d_ARP" % track ),
                ( "and", "_T%d_ENC_4_SELECTED" % track ),
        ], "Select encoder if track %d is selected, arp is on and control is held" % track)

        patch += circuit("encoder", [
            ( "encoder", 1 ),
            ( "select", "_T%d_ENC_4_SELECTED" % track ),
            ( "header", '"Arp pitch range"' ),
            ( "color", 0.4 ),
            ( "discrete", 49 ), # semitones
            ( "startvalue", 24 ),
            ( "sensivity", 4 ),
            ( "output", "_T%d_ARP_RANGE" % track ),
        ], "Encoder for pitch range of arpeggiator" )
    else:
        patch += circuit("pot", track_and_arp_selected(track) + [
            ( "pot", pots["arp_pitch"] ),
            ( "outputscale", 36 ),
            ( "output", "_T%d_ARP_PITCH" % track ),
        ], "Virtual pot for base pitch of arpeggiator" )

        patch += circuit("pot", track_and_arp_selected(track) + [
            ( "pot", pots["arp_range"] ),
            ( "outputscale", 48 ), # semitones
            ( "output", "_T%d_ARP_RANGE" % track ),
        ], "Virtual pot for pitch range of arpeggiator" )

    clock = "_T%d_ARP_CLOCK" % track
    if have_running():
        clock += " * _RUNNING"

    if arguments["tbr"]:
        root_params = [
            ( "root", "_ROOT * _T%d_TBR_OFF" % track ),
            ( "transpose", "_T%d_TBR" % track ),
        ]
    else:
        root_params = [( "root", "_ROOT" )]

    patch += circuit("arpeggio",
        track_note_selects(track, True) +
        root_params + [
        ( "degree", "_DEGREE" ),
        ( "clock", clock ),
        ( "reset", "_RESET" ),
        ( "tuningmode", "_TUNINGMODE" ),
        ( "direction", "_T%d_ARP_UPDOWN" % track ),
        ( "pingpong", "_T%d_ARP_PINGPONG" % track ),
        ( "butterfly", "_T%d_ARP_BUTTERFLY" % track),
        ( "octaves", "_T%d_ARP_OCTAVING" % track),
        ( "drop", "_T%d_ARP_DROP" % track),
        ( "pattern", "_T%d_ARP_PATTERN" % track),
        ( "autoreset", "_T%d_ARP_AUTORESET" % track),
        ( "pitch", "_T%d_ARP_PITCH / 120" % track),
        ( "range", "_T%d_ARP_RANGE / 120" % track),
        ( "output", "_T%d_ARP_OUTPUT" % track),
    ], "Arpeggiator for track %d" % track)

    return patch


def track_note_selects(track, for_arp):
    if arguments["bq"] and not for_arp:
        def sel(n):
            return "_T%d_SEL_%d + _T%d_12TONE" % (track, n, track)
        fill ="_T%d_12TONE" % track
    else:
        def sel(n):
            return "_T%d_SEL_%d" % (track, n)
        fill = 0

    return [
        ( "select1",     sel(1) ),
        ( "select3",     sel(2) ),
        ( "select5",     sel(3) ),
        ( "select7",     sel(4) ),
        ( "select9",     sel(5) ),
        ( "select11",    sel(6) ),
        ( "select13",    sel(7) ),
        ( "selectfill1", fill   ),
        ( "selectfill2", fill   ),
        ( "selectfill3", fill   ),
        ( "selectfill4", fill   ),
        ( "selectfill5", fill   ),
    ]


