        "D=>  =>  <=",
        "D==>  <=",
        "D==>  <==  =>",
        "D==>  =>  <==  =>",
        "Mbrownian",
        "Mrandom",
        ], "_T%d_ARP_PATTERN" % track,
        header = "Movement pattern",
