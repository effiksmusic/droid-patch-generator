def have_midi_tracks():
    for track in range(1, arguments["tracks"] + 1):
        if track_is_midi(track):
            return True
    return False

def have_cvgate_tracks():
    for track in range(1, arguments["tracks"] + 1):
        if track_is_cvgate(track):
            return True
    return False

def have_cv_inputs():
    return arguments["m"] in [ "master", "master+x7" ]

def need_control_button():
    # The root sequencer needs CTRL for its clock divider
    return arguments["clear"] or arguments["presets"] or have_root_sequencer()

def num_faders():
    return int(arguments["nc"]) * 4

# The end step the sequencers start with. This shortens the sequence
# without reducing the number of steps you can reach with the buttons.
# Returns the parameter for the quencers, empty if all steps are played.
def default_end_step():
    steps = arguments["defsteps"]
    if steps <= 0 or steps >= num_steps():
        return []
    else:
        return [ ( "endstep", steps ) ]

def num_steps():
    if arguments["steps"] == "auto":
        return num_faders()
    else:
        return int(arguments["steps"])

# Number of pages the PAGE button switches through. This can be more
# than the number of pages of steps, so that the button and the _PAGE
# cable are there for later extensions of the sequence.
def num_button_pages():
    if arguments["keeppage"] and num_pages() < 2:
        return 2
    else:
        return num_pages()

def num_pages():
    steps = num_steps()
    if steps < num_faders():
        bail_out("If you have %d faders you need to select at least %d steps. "
                 "you have selected just %d steps." % (
                 num_faders(), num_faders(), steps))
    return steps // num_faders()

def get_button(preferred, short, long):
    if len(ios["buttons"]) == 0:
        bail_out("You don't have enough buttons on your B32 controllers "
                 "for all the selected features.")

    button = None
    if preferred:
        # Search inside the group of the preferred position first and
        # only then everywhere else. One free button *must* be found.
        for b in [ button_register(p) for p in button_search_order(preferred) ]:
            try:
                index = ios["buttons"].index(b)
                button = ios["buttons"][index]
                del ios["buttons"][index]
                break
            except:
                pass

    if button is None:
        button = ios["buttons"].pop(0)

    add_label("B" + button, short, long)
    return button


# The buttons for selecting a track. With two B32s they come from the
# reserved block on the second one, otherwise they are allocated like
# any other button.
def get_track_button(short, long):
    return get_reserved_button("trackbuttons", BUTTONPOS_TRACKS, short, long)

def get_menu_button(short, long):
    return get_reserved_button("menubuttons", BUTTONPOS_GLOBALMENUS,
                               short, long)

# Take a button from a reserved place, or allocate one as usual if
# there is none left.
def get_reserved_button(part, preferred, short, long):
    if ios.get(part):
        button = ios[part].pop(0)
        add_label("B" + button, short, long)
        return button
    else:
        return get_button(preferred, short, long)


