def have_performance_menu():
    # The root sequencer sits on the faders of the performance menu
    # and replaces it completely.
    if have_root_sequencer():
        return False

    return arguments["par"] \
        or arguments["pss"] \
        or arguments["poct"] \
        or arguments["pdt"] \
        or arguments["pact"] \
        or arguments["ppat"] \
        or arguments["pcdeven"] \
        or arguments["pcdodd"]

