            ( "ifequal2",  2 ),  # buttonmode gate pattern
            ( "else",      0 ),  # gates
            ( "output",   bmout ),
        ]

        if arguments["gl"]:
            mcargs += [
                ( "compare3", fadermode_for_glide ),
                ( "ifequal3", fadermode_for_glide ),
            ]

        if arguments["velo"] == "vg":
            mcargs += [
                ( "compare4", 10 ),
                ( "ifequal4", 10 ),
            ]

        patch += circuit("multicompare", mcargs,
            "Select a button mode that is most useful in the current fader mode")

        # Range (set start and end point)
        if arguments["range"]:
            patch += circuit("ifequal", [
                ( "input1", "_RANGE" ),
                ( "input2", 0 ),
                ( "ifequal", "_BM" ),
                ( "else", 1 ), # startend
                ( "output", "_BUTTONMODE" ),
            ], "When the range button is active, it always has precedence")

            b = get_reserved_button("rangebutton", BUTTONPOS_RANGE,
                    "S/E", "Set start and end (range of steps to play)")
            patch += circuit("button", [
                ( "button", "B" + b ),
                ( "led", "L" + b ),
                ( "states", 1 ),
                ( "output", "_RANGE" )],
                "Button for choosing between gates on/off and start/end")

    elif arguments["range"]: # no fader mode buttongroup
        patch += circuit("copy", [
            ( "input", "_RANGE" ),
            ( "output", "_BUTTONMODE" ),
        ], "Set the button mode to 1 if the range button is active")

    else:
        patch += circuit("copy", [
            ( "input", 0 ),
            ( "output", "_BUTTONMODE" ),
        ], "The button mode is always 0 in this configuration")

    # Reset
    reset_sources = []

    if arguments["rb"]:
        b = track_buttons["reset"]
        patch += circuit("button", [
            ( "button", "B" + b + " * _CONTROL" ),
            ( "led", "L" + b ),
            ( "states", 1 ),
            ( "output", "_RESET_BUTTON" ),
        ], "Button for reseting all tracks to step 1")
        reset_sources.append("_RESET_BUTTON")

    if arguments["resetin"]:
        reset_sources.append(cv_inputs["reset"])

    if arguments["ssb"]:
        reset_sources.append(( "_STARTSTOP_RESET" ))

    if arguments["runningin"] or arguments["midiinclk"] != "off":
        reset_sources.append(( "_EXT_RUNNING_STARTED" ))

    if arguments["sinflink"] == "res":
        reset_sources.append(( "_SINFLINK_RESET" ))

    args = []
    for nr, source in enumerate(reset_sources):
        args.append(( "input%d" % (nr+1), source))
    patch += circuit("mixer", args + [
        ( "output", "_RESET"),
    ], "Combine all source of global reset")

    # Start/stop
    if arguments["runningin"] and arguments["midiinclk"] != "off":
        bail_out("You have selected to get the running state both from a gate input and from MIDI. "
                 "This is not possible. Please decide which one of both to use.")

    elif arguments["runningin"]:
        running_in = cv_inputs["runningin"]

    elif arguments["midiinclk"] != "off":
        running_in = "_RUNNING_EXT"

    else:
        running_in = 0

    if arguments["runningin"]:
        patch += circuit("gatetool", [
            ( "inputgate", cv_inputs["runningin"] ),
            ( "outputtrigger", "_EXT_RUNNING_STARTED" )],
            "Send trigger when external running state started" )

        patch += circuit("gatetool", [
            ( "inputgate", "1 - " + cv_inputs["runningin"] ),
            ( "outputtrigger", "_EXT_RUNNING_STOPPED" )],
            "Send trigger when external running state stopped" )


    if arguments["ssb"]:
        b = get_reserved_button("startbutton", BUTTONPOS_STARTSTOP,
                       "START",
                       "Start/stop sequencer - start also does reset")

        buttonargs = [
            ( "led", "L" + b ),
            ( "output", "_RUNNING") ]

        # Do we get START/STOP from an external source?
        if arguments["runningin"] or arguments["midiinclk"] != "off":
            buttonargs += [
                ( "button", "B" + b + " + _EXT_RUNNING_STARTED" ),
                ( "startvalue", running_in ),
                ( "clear", "_EXT_RUNNING_STOPPED" ),
            ]
        else:
            buttonargs += [
                ( "button", "B" + b ),
                ( "startvalue", 1 )
            ]

        patch += circuit("button", buttonargs,
            "Button for run/stop")

        patch += circuit("gatetool", [
            ( "inputgate", "_RUNNING" ),
            ( "outputtrigger", "_STARTSTOP_RESET" ),
        ], "Create a reset trigger when the button changes to 'running'")

    # If there is an external input for running, but we don't have
    # a start stop button, we need a different way to make that
    # signal work.
    elif arguments["runningin"] or (arguments["midiinclk"] != "off"):
        patch += circuit("flipflop", [
            ( "set", "_EXT_RUNNING_STARTED" ),
            ( "reset", "_EXT_RUNNING_STOPPED" ),
            ( "output", "_RUNNING" ),
        ], "Remember external start/stop state in a flip flop")


    # Page button(s). Pages can be 1, 2 or 4
    pages = num_button_pages()
    steps = num_steps()
    if pages >= 2:
        b = get_reserved_button("pagebutton", BUTTONPOS_PAGES, "PAGE",
            "Select second page of steps" if pages == 2 else
            "Cycle through the %d pages of steps" % pages)
        button = "B" + b

        # If you press the track button of the already selected
        # track, the page is toggled.
        if arguments["tracks"] > 1:
            button += "+ _TRACK_EXTRA_PRESS"

        patch += circuit("button", [
            ( "button", button ),
            ( "led", "L" + b ),
            ( "output", "_PAGE" ),
            ( "states", pages ),
        ], "Button for selecting the second page of steps")

    # DB8E
    if arguments["cn"] == "d":
        if arguments["dcon"]:
            patch += circuit("button", [
                ( "button", "B1.9" ),
                ( "output", "_TAKOVER_CONTROLS" ),
                ( "startvalue", 1 ),
                ( "dontsave", 1 ),
            ], "Toggle display mode via push button in the encoder")

        patch += circuit("display", [
                ( "takeovercontrols", "_TAKOVER_CONTROLS" if arguments["dcon"] else 1 ),
            ], "Use buttons on DB8E for note selection")

    if num_pages() > 1 and have_display():
        pages = num_pages()
        steps = num_steps()
        steps_per_page = steps / pages
        choices = []
        for p in range(pages):
            choices.append("Steps %d ... %d" % (
                        p * steps_per_page + 1,
                        (p+1) * steps_per_page))

        patch += display_list_choice(choices, "_PAGE", "_PAGE_NAME", "Page")

    return patch

def track_presets(track):
    patch = ""

    # In global mode the preset buttons exist just once, see
    # section_presets()
    if arguments["presets"] == 0 or global_presets():
        return ""

    load_mixing = []
    save_mixing = []
    for p in range(1, arguments["presets"] + 1):
        b = track_buttons[ "preset%d" % p]

        patch += circuit("button", track_selected(track) + [
            ( "button", "B" + b  + "* _CONTROL"),
            ( "states", 1 ),
            ( "onvalue", p ),
            ( "output", "_T%d_P%d_LOAD" % (track, p ) ),
        ], "Button for loading preset %d on track %d" % (p, track))
        load_mixing.append(( "input%d" % p, "_T%d_P%d_LOAD" % (track, p )))

        patch += circuit("button", track_selected(track) + [
            ( "button", "B" + b ),
            ( "states", 1 ),
            ( "onvalue", p ),
            ( "longpress", "_T%d_P%d_SAVE" % (track, p ) ),
        ], "Button for saving preset %d on track %d" % (p, track))
        save_mixing.append(( "input%d" % p, "_T%d_P%d_SAVE * %d" % (track, p, p)))

        patch += display_event("_T%d_P%d_LOAD" % (track, p ), "Preset %d loaded" % p )
        patch += display_event("_T%d_P%d_SAVE" % (track, p ), "Preset %d saved" % p )

        patch += circuit("burst", [
            ( "trigger", "_T%d_P%d_SAVE" % (track, p) ),
            ( "hz", 5 ),
            ( "count", 5 ),
            ( "output", "_T%d_P%d_SAVE_LED" % (track, p) ),
        ], "Five blinks for the LED of the preset button on saving")

        patch += circuit("select", track_selected(track) + [
            ( "input", "_T%d_P%d_SAVE_LED + 0.3" % (track, p) ),
            ( "output", "L" + b ),
        ], "Write the save LED animation to the LED if the track is still selected." )

    patch += circuit("mixer", load_mixing + [
        ( "output", "_T%d_LOAD_PRESET" % track )
    ], "Create a trigger with the preset as value when any of the presets is loaded" )
    patch += circuit("mixer", save_mixing + [
        ( "output", "_T%d_SAVE_PRESET" % track )
    ], "Create a trigger with the preset as value when any of the presets is saved" )


    return patch

def track_preset_params(track):
    if arguments["presets"] == 0:
        return []

    if global_presets():
        return preset_params("")

    return preset_params("_T%d" % track)

def preset_params(prefix):
    if prefix == "":
        # The global presets come from a button group, which hands out
        # the number of the preset in a cable of its own.
        return [
            ( "preset", "_PRESET_SELECT" ),
            ( "loadpreset", "_LOAD_PRESET" ),
            ( "savepreset", "_SAVE_PRESET" ),
        ]

    return [
        ( "loadpreset", "%s_LOAD_PRESET" % prefix ),
        ( "savepreset", "%s_SAVE_PRESET" % prefix ),
    ]

# The preset buttons for everything at once: all tracks and the root
# sequencer share one set of presets. This saves the whole per track
# button logic, which is four circuits per track and preset.
def section_presets():
    if not global_presets():
        return ""

    patch = section_header("Presets")

    # One button group for all presets: a short press loads, a long
    # press saves, and the LED of the selected preset stays on.
    args = []
    for p in range(1, arguments["presets"] + 1):
        args += [
            ( "button%d" % p, "B" + track_buttons["preset%d" % p] ),
            ( "value%d" % p, p ),
            ( "led%d" % p, "_PRESET_LED%d" % p ),
        ]

    patch += circuit("buttongroup", args + [
        ( "longpresstime", 0.8 ),
        ( "buttonpress", "_LOAD_PRESET" ),
        ( "longpress", "_SAVE_PRESET" ),
        ( "output", "_PRESET_SELECT" ),
        ( "header", '"Presets"' ),
    ], "Presets for all tracks together")

    patch += circuit("burst", [
        ( "trigger", "_SAVE_PRESET" ),
        ( "hz", 5 ),
        ( "count", 5 ),
        ( "output", "_PRESET_ANIM" ),
    ], "Five blinks on saving a preset")

    patch += circuit("copy", [
        ( "input", "_PRESET_ANIM * -0.75" ),
        ( "output", "_PRESET_BLINK" ),
    ], "Darken the LED while it blinks")

    for p in range(1, arguments["presets"] + 1):
        patch += circuit("copy", [
            ( "input", "_PRESET_LED%d * _PRESET_BLINK + _PRESET_LED%d"
                       % (p, p) ),
            ( "output", "L" + track_buttons["preset%d" % p] ),
        ], "LED of preset button %d, on while it is the selected one" % p)

    return patch


def track_sections():
    global building_track

    patch = section_selectat_numbers()
