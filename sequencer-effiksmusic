# Root note and scale go out as a note and CC#1 - the same scheme that
# the MIDI input for root and scale uses.
def root_sequencer_midi_output():
    port = arguments["rsout"]
    if port == "off":
        return ""

    if not have_midi():
        bail_out("You have set the root sequencer to send MIDI, but "
                 "for that you need a MASTER18 or a MASTER + X7.")

    if port == "usb":
        portarg = ( "usb", 1 )
    elif port == "trs1":
        portarg = ( "trs", 1 )
    else:
        if arguments["m"] != "master18":
            bail_out("The root sequencer is sending MIDI to TRS port 2, "
                     "but that port is just available on the MASTER18.")
        portarg = ( "trs", 2 )

    return circuit("midiout", [
        portarg,
        ( "channel", arguments["rschan"] ),
        ( "pitch", "_ROOT / 120" ),
        ( "gate", "_RS_ON" ),
        ( "ccnumber1", 1 ),
        ( "cc1", "_DEGREE / 127" ),
        ( "activesensing", 0 ),
    ], "Send root note and scale to MIDI")

# Are the steps and menus run by E4 encoders instead of M4 motor faders?
def use_encoders():
    return arguments["c"] == "e4"

# Encoder numbers are counted over the whole setup, and the numeric
# form of firstfader even counts motor faders. Register names like
# E3.1 are unambiguous, so all encoders are addressed that way.
def encoder_register(number):
    e4 = (number - 1) // 4
    return "E%d.%d" % (step_positions[e4], (number - 1) % 4 + 1)

# One virtual fader: a motorfader on the M4, an encoder on the E4.
def fader_circuit(params, comment=""):
    if not use_encoders():
        return circuit("motorfader", params, comment)

    translated = []
    for name, value in params:
        # A negative ledvalue means "full brightness while the fader is
        # at its start value". The LED ring of an encoder has no such
        # mode, and it shows the value anyway, so this is dropped.
        if name == "ledvalue" and isinstance(value, (int, float)) and value < 0:
            continue
        name = FADER_TO_ENCODER_PARAM.get(name, name)
        if name == "encoder" and isinstance(value, int):
            value = encoder_register(value)
        translated.append(( name, value ))
    return circuit("encoder", translated, comment)

# The step sequencer itself: motoquencer on the M4, encoquencer on the E4.
def quencer_circuit(params, comment=""):
    if not use_encoders():
        return circuit("motoquencer", params, comment)

    params = list(params)
    # Only the leading sequencer defines the controls. The linked ones
    # inherit them, exactly like with the motoquencer. nume4s is only
    # honored with zorder 1 or 3, but setting it never hurts.
    if any(name == "numfaders" for name, value in params):
        params.append(( "zorder", ENCOQUENCER_ZORDER ))
        params.append(( "nume4s", int(arguments["nc"]) ))
        params.append(( "firstfader", encoder_register(1) ))
    return circuit("encoquencer", params, comment)

def num_buttons():
    return 32 * num_b32()

def button_zone(position):
    for first, last in BUTTON_ZONES:
        if first <= position <= last:
            return ( first, last )
    return ( 1, num_buttons() )

# All button positions, starting at the preferred one and staying
# inside its group as long as possible
def button_search_order(preferred):
    first, last = button_zone(preferred)
    order = list(range(preferred, last + 1)) + list(range(first, preferred))
    order += [ p for p in range(1, num_buttons() + 1)
               if not (first <= p <= last) ]
    return order

# Groups of button positions that belong together. A button looks for
# a free place inside its own group first, so that a feature of the
# upper half cannot take the place of one from the lower half.
BUTTON_ZONES                = [ (1, 16), (17, 28), (29, 32) ]

# Translate a button position (1 ... 32 on the first B32, 33 ... 64 on
# the second one) into a register like "2.7". Positions beyond the last
# button wrap around to the first one.
def button_register(position):
    position = (position - 1) % num_buttons()
    return "%d.%d" % (b32_positions[position // 32], position % 32 + 1)

def section_header(title):
    line = "# " + "-" * 50 + "\n"
    return "\n" + line + "# " + title + "\n" + line + "\n"


def display_list_choice(choices, cable_name, text_cable="", header="", fontsize=2):
    if skip_display_text():
        return ""

    if not have_display():
        return ""

    if text_cable == "":
        text_cable = cable_name + "_NAME"

    if len(choices) == 2:
        patch = circuit("ifequal",  [
            ( "input1", cable_name ),
            ( "input2", 0 ),
            ( "ifequal", '"%s"' % choices[0] ),
            ( "else", '"%s"' % choices[1] ),
            ( "output", text_cable ),
        ], "Names for the display")

    else:
        args = [
            ( "input%d" % (n + 1), '"%s"' % choice )
            for n, choice in enumerate(choices)
        ]

        patch = circuit("switch", args + [
            ( "offset", cable_name ),
            ( "output", text_cable ),
        ], "Names for the display")

    patch += circuit("display", [
        ( "linger", "0.1" ),
        ( "header", '"%s"' % header.upper() ),
        ( "text", text_cable ),
        ( "fontsize", fontsize ),
    ], "Display the name of '%s' when edited" % header)

    return patch

def display_event(cable, message):
    if skip_display_text():
        return ""

    if have_display():
        return circuit("display", [
                ( "trigger", cable ),
                ( "text", '"%s"' % message ),
        ], "Show a message when %s triggers" % cable )
    else:
        return ""



