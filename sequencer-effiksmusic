# With global presets the root sequencer simply joins in. Otherwise it
# gets its own presets, saved while its menu is selected - the same way
# a track saves its presets while it is selected.
def root_sequencer_presets():
    if arguments["presets"] == 0 or global_presets():
        return ""

    active = [ ( "select", "L%s" % rs_menu_button ) ]
    patch = ""
    load_mixing = []
    save_mixing = []

    for p in range(1, arguments["presets"] + 1):
        b = track_buttons["preset%d" % p]

        patch += circuit("button", active + [
            ( "button", "B" + b + " * _CONTROL" ),
            ( "states", 1 ),
            ( "onvalue", p ),
            ( "output", "_RS_P%d_LOAD" % p ),
        ], "Button for loading preset %d of the root sequencer" % p)
        load_mixing.append(( "input%d" % p, "_RS_P%d_LOAD" % p ))

        patch += circuit("button", active + [
            ( "button", "B" + b ),
            ( "states", 1 ),
            ( "onvalue", p ),
            ( "longpress", "_RS_P%d_SAVE" % p ),
        ], "Button for saving preset %d of the root sequencer" % p)
        save_mixing.append(( "input%d" % p, "_RS_P%d_SAVE * %d" % (p, p) ))

        patch += display_event("_RS_P%d_LOAD" % p, "Preset %d loaded" % p)
        patch += display_event("_RS_P%d_SAVE" % p, "Preset %d saved" % p)

        patch += circuit("burst", [
            ( "trigger", "_RS_P%d_SAVE" % p ),
            ( "hz", 5 ),
            ( "count", 5 ),
            ( "output", "_RS_P%d_SAVE_LED" % p ),
        ], "Five blinks for the LED of the preset button on saving")

        patch += circuit("select", active + [
            ( "input", "_RS_P%d_SAVE_LED + 0.3" % p ),
            ( "output", "L" + b ),
        ], "Write the LED animation only while the root sequencer is "
           "selected")

    patch += circuit("mixer", load_mixing + [
        ( "output", "_RS_LOAD_PRESET" ),
    ], "Trigger with the preset as value when a preset is loaded")
    patch += circuit("mixer", save_mixing + [
        ( "output", "_RS_SAVE_PRESET" ),
    ], "Trigger with the preset as value when a preset is saved")

    return patch

# The clear button works like it does for a track: with CTRL it clears
# the sequence, without CTRL it resets start and end.
def root_sequencer_clear():
    if not arguments["clear"]:
        return ""

    b = track_buttons["clear"]
    active = [ ( "select", "L%s" % rs_menu_button ) ]

    patch = circuit("button", active + [
        ( "button", "B" + b ),
        ( "shortpress", "_RS_CLEAR_BUTTON" ),
        ( "states", 1 ),
    ], "Trigger when the clear button is pressed in the root sequencer")

    patch += circuit("copy", [
        ( "input", "_RS_CLEAR_BUTTON * _CONTROL" ),
        ( "output", "_RS_CLEAR" ),
    ], "Clear button with control clears the root sequence")

    # Without the range feature there is no start and end to reset
    if arguments["range"]:
        patch += circuit("logic", [
            ( "input1", "_RS_CLEAR_BUTTON" ),
            ( "input2", "1 - _CONTROL" ),
            ( "and", "_RS_PEACE" ),
