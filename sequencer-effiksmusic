        ( "taptempo", "_CLOCK" ),
        ( "reset", "_RESET" ),
        ( "cv", "_ROOT_SEQ_CV" ),
        ( "gate", "_ROOT_SEQ_GATE" ),
        ( "cvnotches", 12 ),
        ( "cvbase", 0 ),
        ( "cvrange", 1 ),   # 1 means 10 V
        ( "defaultcv", 0 ),
        ( "defaultgate", 0 ),
        ( "quantize", 0 ),
        ( "holdcv", 1 ),
        ( "buttonmode", "_RANGE" if arguments["range"] else 0 ),
        ( "buttoncolor", COLOR_ROOT ),
        ( "bulkedit", "_CONTROL" ),
        ( "cvname", '"Root offset"' ),
        ( "fadermode", "_RS_FADERMODE" ),
