    if have_performance_menu():
        entries = len(performance_menu[1]) * arguments["tracks"]
        for page in range(perfmenu_pages()):
            used = entries - page * num_faders()
            if used > num_faders():
                used = num_faders()
            patch += unused_faders(used + 1, perfmenu_select(page))
    return patch

# The performance menu shows one fader per track and feature. If that
# does not fit on the faders you have, it is spread over several pages.
def perfmenu_pages():
    if not have_performance_menu():
        return 1

    entries = len(performance_menu[1]) * arguments["tracks"]
    return (entries + num_faders() - 1) // num_faders()

# Page and fader number of one entry of the performance menu
def perfmenu_position(entry):
    return ( (entry - 1) // num_faders(), (entry - 1) % num_faders() + 1 )

# Select parameters for one page of the performance menu
def perfmenu_select(page):
    if perfmenu_pages() <= 1:
        return [
            ( "select", "_GLOBAL_FADER_SELECTION" ),
            ( "selectat", 98 ),
        ]
    else:
        return [
            ( "select", "%s * 1000 + _GLOBAL_FADER_SELECTION" % perfmenu_page_cable() ),
            ( "selectat", 98 + 1000 * page ),
        ]

# The page of the performance menu comes from the PAGE button of the
# steps, as long as that has enough pages. Otherwise it gets a button
# of its own.
def perfmenu_page_cable():
    if num_button_pages() >= perfmenu_pages():
        return "_PAGE"
    else:
        return "_PERF_PAGE"

def section_perfmenu_page_button():
    if perfmenu_pages() <= 1 or perfmenu_page_cable() == "_PAGE":
        return ""

    pages = perfmenu_pages()
    b = get_button(BUTTONPOS_PAGES, "PPAGE",
        "Select second page of the performance menu" if pages == 2 else
        "Cycle through the %d pages of the performance menu" % pages)
    return circuit("button", [
        ( "button", "B" + b ),
        ( "led", "L" + b ),
        ( "output", "_PERF_PAGE" ),
        ( "states", pages ),
    ], "Button for paging through the performance menu")

def patch_title():
    patch = "# Melody sequencer with %d tracks\n" % arguments["tracks"]
    if arguments["m"] == "master18":
        patch += "# LABELS: master=18\n"
    return patch

def patch_controllers():
    global drum_b32_position
    global drum_e4_position
    global b32_position
    global b32_positions
    global step_positions
    global notesel_position

    controllers = []

    if arguments["cn"] == "p": # P2B8
        controllers = [ "p2b8" ]
        notesel_position = 1
    elif arguments["cn"] == "d": # DB8E
        controllers = [ "db8e" ]
        notesel_position = 1
    else: # P2B8 + DB8E
        controllers = [ "db8e", "p2b8" ]
        notesel_position = 2

    # One B32 is enough for up to four tracks. Beyond that the track
    # buttons plus the optional features do not fit onto 32 buttons
    # any more, so a second B32 is added directly behind the first one.
    b32_positions = []
    for i in range(num_b32()):
        b32_positions.append(len(controllers) + 1)
        controllers.append("b32")
    b32_position = b32_positions[0] # kept for compatibility

    step_positions = []
    for i in range(int(arguments["nc"])):
        step_positions.append(len(controllers) + 1)
        controllers.append(arguments["c"])

    # The drum part brings its own controllers, which are not part of
    # the pool of free buttons.
    if have_drums():
        drum_b32_position = len(controllers) + 1
        controllers.append("b32")
        drum_e4_position = len(controllers) + 1
        controllers.append("e4")

    return "".join([ "[%s]\n" % c for c in controllers])

def num_b32():
    if arguments["tracks"] >= TRACKS_FOR_SECOND_B32:
        return 2
    else:
        return 1


# ------------------------------------------------------------------
# Synced track sections
#
# The Forge syncs sections that are identical apart from the track
# number in the cable names. Two things break that: numbers that
# depend on the track (selectat) and the jacks of the outputs, which
# are different for every track. So the numbers become cables like
# _T1_SELECTAT and the jack wiring is moved into its own section.
# ------------------------------------------------------------------

deferred_patch = {}

# Register of the button that selects the root sequencer
rs_menu_button              = None

def sync_sections():
    return arguments["syncsec"] and arguments["tracks"] > 1

# Value for selectat inside a track section
def track_selectat(track, offset=0):
    if not sync_sections():
        return track + offset
    elif offset:
        return "_T%d_SELECTAT + %d" % (track, offset)
    else:
        return "_T%d_SELECTAT" % track

# Cable holding the running state of one track
def running_or_compose(track):
    if sync_sections():
        return "_T%d_RUNNING_OR_COMPOSE" % track
    else:
        return "_RUNNING_OR_COMPOSE_%d" % track

# Circuits that touch a jack of this track. With synced sections they
# are collected and printed in a section of their own further down.
def defer(part, patch):
    if sync_sections():
        deferred_patch[part] = deferred_patch.get(part, "") + patch
        return ""
    else:
        return patch

# Inside a track section every comment has to read the same for all
# tracks, so the track number is taken out of it.
def strip_track_number(patch, track):
    if not sync_sections():
        return patch

    lines = []
    for line in patch.split("\n"):
        if line.startswith("#") and not line.startswith("# ---"):
            line = line.replace(" track %d" % track, " this track")
            line = line.replace(" of track %d" % track, " of this track")
        lines.append(line)
    return "\n".join(lines)

def deferred_sections():
    patch = ""
    for title in ( "Performance menu", "Track outputs" ):
        if deferred_patch.get(title):
            patch += section_header(title) + deferred_patch[title]
    return patch

# One copy circuit per track holds the number that the track sections
# use for selectat.
def section_selectat_numbers():
    if not sync_sections():
        return ""

    patch = section_header("Section numbers")
    for track in range(1, arguments["tracks"] + 1):
        patch += circuit("copy", [
            ( "input", track ),
            ( "output", "_T%d_SELECTAT" % track ),
        ], "Number of the section of track %d" % track)

        # The chord track needs eight notches on its second layer for
        # the harmonic shift. Putting that into a cable keeps all track
        # sections identical - but only where that layer exists.
        if has_velocity_layer(track) and arguments["velo"] != "g":
            patch += circuit("copy", [
                ( "input", 8 if is_chord_track(track) else 0 ),
                ( "output", "_T%d_CVNOTCHES" % track ),
            ], "Notches of the second layer of track %d" % track)

            base, span = second_layer_range(track)
            patch += circuit("copy", [
                ( "input", base ),
                ( "output", "_T%d_LAYER_BASE" % track ),
            ], "Lowest value of the second layer of track %d" % track)
            patch += circuit("copy", [
                ( "input", span ),
                ( "output", "_T%d_LAYER_RANGE" % track ),
            ], "Range of the second layer of track %d" % track)
    return patch


# ------------------------------------------------------------------
