                ( "else", 0 ),
                ( "output", "_RS_FADERMODE" ),
            ], "VELO switches the root sequencer to the scale")
        else:
            patch += circuit("ifequal", [
                ( "input1", "_FADERMODE" ),
                ( "input2", 0 ),
                ( "ifequal", 0 ),
                ( "else", 10 ),
                ( "output", "_RS_FADERMODE" ),
            ], "Everything but NOTE switches the root sequencer to "
               "the scale")

        if have_display():
            patch += circuit("ifequal", [
                ( "input1", "_RS_FADERMODE" ),
                ( "input2", 0 ),
                ( "ifequal", '"Root offset"' ),
                ( "else", '"Scale offset"' ),
                ( "output", "_RS_FADERMODE_NAME" ),
