# One encoder of the drum part carries two parameters. Pressing the
# encoder switches between them, holding it clears the current one.
def drum_encoder_pair(track, number, first, second):
    sel = "_D%d_SELECT" % track
    patch = circuit("button", [
        ( "select", sel ),
        ( "button", drum_button_of_encoder(number) ),
        ( "startvalue", 0 ),
        ( "clear", "_D%d_CLEAR + _DRUMS_SELECT_CHANGE" % track ),
        ( "output", "_D%d_SWITCH_%s" % (track, second["name"]) ),
        ( "negated", "_D%d_SWITCH_%s" % (track, first["name"]) ),
        ( "longpress", "_D%d_SWITCH_CLEAR_E%d" % (track, number) ),
    ], "Press encoder %d to switch between %s and %s"
       % (number, first["header"], second["header"]))

    for which in ( first, second ):
        patch += circuit("encoder", [
            ( "select", "%s * _D%d_SWITCH_%s" % (sel, track, which["name"]) ),
            ( "encoder", drum_encoder(number) ),
            ( "clear", "_D%d_SWITCH_CLEAR_E%d * _D%d_SWITCH_%s + _D%d_CLEAR"
                       % (track, number, track, which["name"], track) ),
        ] + which["args"] + ( [
            ( "preset", "_DRUMS_PRESET_SELECT" ),
            ( "loadpreset", "_DRUMS_PRESET_LOAD" ),
            ( "savepreset", "_DRUMS_PRESET_SAVE" ),
        ] if which["preset"] else [] ) + [
            ( "output", "_D%d_%s" % (track, which["name"]) ),
            ( "header", '"%s"' % which["header"] ),
        ], "")
    return patch

# The push buttons of the E4 encoders
def drum_button_of_encoder(number):
    return "B%d.%d" % (drum_e4_position, number)

def drum_parameter(name, header, args, preset=True):
    return { "name" : name, "header" : header,
             "args" : args, "preset" : preset }

def drum_track(track):
    patch = drum_encoder_pair(track, 1,
        drum_parameter("ACTIVITY", "Activity", [
            ( "color", 0.4 ), ( "notch", 0.1 ), ( "startvalue", 0.5 ) ]),
        drum_parameter("OFFBEAT", "Offbeat", [
            ( "color", 0.2 ), ( "notch", 0.1 ), ( "startvalue", 0.5 ) ]))

    patch += drum_encoder_pair(track, 2,
        drum_parameter("SWING", "Swing", [
            ( "color", 1 ), ( "outputscale", 0.33 ) ], preset=False),
        drum_parameter("PATTERN", "Pattern", [
            ( "discrete", len(DRUM_PATTERNS) ), ( "color", 1.1 ),
            ( "startvalue", 0.5 ) ], preset=False))

    patch += drum_encoder_pair(track, 3,
        drum_parameter("FILLS", "Fills", [
            ( "color", 0.73 ), ( "startvalue", 0 ) ]),
        drum_parameter("VARIATION", "Variation", [
            ( "color", 0.6 ), ( "startvalue", 0 ) ]))

    patch += drum_encoder_pair(track, 4,
        drum_parameter("EUCLID_BEATS", "Euclid Beats", [
            ( "discrete", 16 ), ( "color", 1.2 ),
            ( "startvalue", 0 ), ( "outputoffset", 1 ) ]),
        drum_parameter("EUCLID_LENGTH", "Euclid Length", [
            ( "discrete", 16 ), ( "color", 0.8 ),
            ( "startvalue", 15 ), ( "outputoffset", 1 ) ]))

    patch += circuit("timing", [
        ( "clock", drum_clock() ),
        ( "reset", "_RESET" ),
        ( "timing1", 0 ),
        ( "timing2", "_D%d_SWING" % track ),
        ( "output", "_D%d_CLOCK" % track ),
    ], "Swing of drum track %d" % track)

    # The three algoquencer buttons belong to the selected track
    for b, extra in (
            ( DRUMBUTTON_ALTERNATE, "_DRUMS_ALTERNATEFILL_LED * 0.5 + " ),
            ( DRUMBUTTON_ACCENT, "" ),
            ( DRUMBUTTON_LENGTH, "" ) ):
        patch += circuit("select", [
            ( "select", "_D%d_SELECT * _DRUMS_SHIFT_OFF" % track ),
            ( "input", extra + drum_button(b) ),
            ( "output", drum_led(b) ),
        ], "")

    # The predefined patterns, packed into two blocks of eight bits
    for block in ( 1, 2 ):
        args = []
        for nr, pattern in enumerate(DRUM_PATTERNS):
            args.append(( "compare%d" % (nr + 1), nr ))
            args.append(( "ifequal%d" % (nr + 1), pattern[block - 1] ))
        patch += circuit("multicompare", [
            ( "input", "_D%d_PATTERN" % track ),
        ] + args + [
            ( "output", "_D%d_PATTERN_BLOCK%d" % (track, block) ),
        ], "Predefined patterns, steps %d to %d"
           % (block * 8 - 7, block * 8))

        patch += circuit("adc", [
            ( "input", "_D%d_PATTERN_BLOCK%d" % (track, block) ),
        ] + [ ( "bit%d" % n, "_D%d_BLOCK%d_STEP%d" % (track, block, n) )
              for n in range(1, 9) ],
           "Unpack the pattern into single steps")

    args = []
    for step in range(1, 17):
        block = 1 if step <= 8 else 2
        args.append(( "button%d" % step,
            "%s + _D%d_BLOCK%d_STEP%d" % (drum_button(DRUMBUTTON_STEPS + step - 1),
                                          track, block, (step - 1) % 8 + 1) ))
    for step in range(1, 17):
        args.append(( "led%d" % step, drum_led(DRUMBUTTON_STEPS + step - 1) ))

    patch += circuit("algoquencer", [
        ( "select", "_D%d_SELECT" % track ),
        ( "clock", drum_running("_D%d_CLOCK" % track) ),
        ( "reset", "_RESET" ),
    ] + args + [
        ( "clear", "_D%d_CLEAR" % track ),
        ( "reroll", "_DRUMS_REROLL" ),
        ( "lengthbutton", "%s * _DRUMS_SHIFT_OFF" % drum_button(DRUMBUTTON_LENGTH) ),
        ( "accentbutton", "%s * _DRUMS_SHIFT_OFF" % drum_button(DRUMBUTTON_ACCENT) ),
        ( "alternatebutton", "%s * _DRUMS_SHIFT_OFF" % drum_button(DRUMBUTTON_ALTERNATE) ),
        ( "alternatebars", "_DRUMS_ALTERNATEFILL" ),
        ( "activity", "_D%d_ACTIVITY" % track ),
        ( "variation", "_D%d_VARIATION" % track ),
        ( "offbeats", "_D%d_OFFBEAT" % track ),
        ( "fills", "_D%d_FILLS" % track ),
        ( "fillorder", "-1 * 1 + _DRUMS_ALTERNATEFILL" ),
        ( "startaccents", 0 ),
        ( "preset", "_DRUMS_PRESET_SELECT" ),
        ( "loadpreset", "_DRUMS_PRESET_LOAD" ),
        ( "savepreset", "_DRUMS_PRESET_SAVE" ),
        ( "accent", "_D%d_ACCENT" % track ),
        ( "trigger", "_D%d_ALGO_TRIGGER" % track ),
    ], "The drum sequencer of track %d" % track)

    patch += circuit("euklid", [
        ( "clock", drum_running("_D%d_CLOCK" % track) ),
        ( "reset", "_RESET" ),
        ( "length", "_D%d_EUCLID_LENGTH" % track ),
        ( "beats", "-1 * 1 + _D%d_EUCLID_BEATS" % track ),
        ( "output", "_D%d_EUCLID_TRIGGER" % track ),
    ], "Euclidean rhythm, added to the sequence")

    return patch

# Trigger and accent of one drum track belong together, so they go to
# two neighboring jacks of a G8: the trigger on the odd one, the accent
# on the even one right below it.
def drum_gate_pair(track):
    free = ios["gateinouts"]
    for jack in sorted(free, key=gate_jack_number):
        number = gate_jack_number(jack)
        if number[1] % 2 == 0:
            continue
        partner = "G%d.%d" % (number[0], number[1] + 1)
        if partner in free:
            free.remove(jack)
            free.remove(partner)
            return (
                add_label(jack, "Drum %d" % track,
                          "Trigger of drum track %d" % track),
                add_label(partner, "Accent %d" % track,
                          "Accent of drum track %d" % track))

    # No pair of G8 jacks left, so take whatever is free
    return (
        get_gate_output("Drum %d" % track,
                        "Trigger of drum track %d" % track),
        get_gate_output("Accent %d" % track,
                        "Accent of drum track %d" % track))

# Controller and jack number of a register like "G2.5"
def gate_jack_number(jack):
    controller, number = jack[1:].split(".")
    return ( int(controller), int(number) )

def drum_outputs():
    patch = ""
    for track in range(1, arguments["drums"] + 1):
        b = DRUMBUTTON_MUTES + track - 1

        patch += circuit("button", [
            ( "select", "_DRUMS_SHIFT_OFF" ),
            ( "preset", "_DRUMS_PRESET_SELECT" ),
            ( "loadpreset", "_DRUMS_PRESET_LOAD" ),
            ( "savepreset", "_DRUMS_PRESET_SAVE" ),
            ( "button", drum_button(b) ),
            ( "startvalue", 1 ),
            ( "clear", "_D%d_CLEAR" % track ),
            ( "led", drum_led(b) ),
            ( "output", "_D%d_MUTE" % track ),
        ], "Mute drum track %d" % track)

        patch += circuit("select", [
            ( "select", "_DRUMS_SHIFT_ON" ),
            ( "input", drum_button(b) ),
            ( "output", "_D%d_MANUAL_TRIGGER" % track ),
        ], "CTRL + mute button triggers the drum by hand")

        trigger, accent = drum_gate_pair(track)

        patch += circuit("mixer", [
            ( "input1", "_D%d_MANUAL_TRIGGER" % track ),
            ( "input2", "_D%d_ALGO_TRIGGER * _D%d_MUTE" % (track, track) ),
            ( "input3", "_D%d_EUCLID_TRIGGER * _D%d_MUTE" % (track, track) ),
            ( "output", trigger ),
        ], "Trigger output of drum track %d" % track)

        patch += circuit("copy", [
            ( "input", "_D%d_ACCENT * _D%d_MUTE" % (track, track) ),
            ( "output", accent ),
        ], "Accent output of drum track %d" % track)

    return patch

# True while the patch of a track is being built. The texts of the
# tracks are the same on every track, so they are the first thing to
# drop when the display costs too much RAM.
building_track              = False

def skip_display_text():
    return arguments["lessdisplay"] and building_track

# TON, CLK, TRK and PERF respectively ROOT
def num_menu_buttons():
    number = 2   # tonality and track menu
    if arguments["intclk"]:
        number += 1
    if have_root_sequencer() or have_performance_menu():
        number += 1
    return number

# The two lucky buttons take the place of the arpeggiator, which then
# moves up to the place of the CHRO button.
def arpeggiator_button_position():
    if have_two_lucky_buttons():
        return BUTTONPOS_DISABLE_QUANT
    else:
        return BUTTONPOS_ARPEGGIATOR

# On a chord track the sequencer plays four voices of a chord. The
# layer that would be the velocity sets the harmonic shift instead.
def num_chord_voices():
    return arguments["chordvoices"]

def is_chord_track(track):
    return arguments["chordtrack"] == track \
       and track <= arguments["tracks"]

# Where the velocity of this track goes
def velocity_to_cv(track):
    return arguments["t%dvelo" % track] == "cv"

def velocity_to_midi(track):
    return arguments["t%dvelo" % track] == "midi"

# The layer stays on the faders but its value is not sent anywhere.
# This keeps the track sections identical without spending an output.
def velocity_goes_nowhere(track):
    return arguments["t%dvelo" % track] == "none"

# Does this track have a second sequencer layer below the pitch?
def has_velocity_layer(track):
    if is_chord_track(track):
        return True   # it carries the harmonic shift there
    elif arguments["velo"] == "off":
        return False

    # Every track has at least one kind of output, and the velocity
    # falls back to it if the chosen one is not available here.
    return True

# Lowest value and range of the second sequencer layer. A normal track
# uses the velocity range from the patch generator, the chord track
# needs plain numbers for the harmonic shift.
def second_layer_range(track):
    if is_chord_track(track):
        return ( CHORD_LAYER_BASE, CHORD_LAYER_RANGE )
    else:
        return ( "%.3fV" % (arguments["velomin"] * 0.001),
                 "%.3fV" % ((arguments["velomax"] - arguments["velomin"])
                            * 0.001) )

# Does the velocity of this track get a CV output? "MIDI only" cannot
# apply to a track that does not send MIDI, so there it falls back to
# the CV output.
def velocity_has_cv_output(track):
    return not velocity_goes_nowhere(track) \
       and arguments["velo"] in ( "v", "vg" ) \
       and track_is_cvgate(track) \
       and not is_chord_track(track) \
       and (velocity_to_cv(track) or not track_is_midi(track))

# The same the other way round: on a track without CV outputs the
# velocity goes to MIDI even if the CV output was chosen.
def velocity_goes_to_midi(track):
    return not velocity_goes_nowhere(track) \
       and arguments["velo"] in ( "v", "vg" ) \
       and not is_chord_track(track) \
       and (velocity_to_midi(track) or not track_is_cvgate(track))

# Lucky on two buttons instead of one button plus CTRL
def have_two_lucky_buttons():
    return arguments["lucky"] and arguments["lucky2"]

# The lucky base sits on the fader that the activity would use, so it
# is only available while the activity is switched off.
def have_lucky_base():
    return arguments["luckybase"] and arguments["lucky"] \
        and not arguments["act"]

def have_drums():
