        ( "input", "_T%d_ARP_OCTAVE_SWITCH * 1V - 2V" % track ),
        ( "output", "_T%d_ARP_OCTAVE" % track ),
    ], "Compute octave offset pitches from fader setting" )

    patch += fader_circuit(params + [
        ( "fader", 6 ),
        ( "notches", 7 ),
        ( "ledcolor", COLOR_PATTERN ),
        ( "ledvalue", 1 ),
