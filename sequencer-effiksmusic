def collect_ios():
    global ios
    ios = {
        "buttons"    : [ button_register(b) for b in range(1, num_buttons() + 1) ],
        "gateouts"   : [],
        "gateins"    : [],
        "gateinouts" : [], # G8 gates
        "cvins"      : [],
        "cvouts"     : [],
        "trackbuttons" : [],
    }

    # The global menus always start at the same place, so no feature
    # may take their buttons.
    ios["menubuttons"] = []
    for nr in range(num_menu_buttons()):
        b = button_register(BUTTONPOS_GLOBALMENUS + nr)
        ios["buttons"].remove(b)
        ios["menubuttons"].append(b)

    # These three always sit on the same button, no matter which of the
    # other features are switched on.
    for part, position, needed in (
            ( "rangebutton", BUTTONPOS_RANGE, arguments["range"] ),
            ( "copybutton", BUTTONPOS_COPY, arguments["copy"] != "off" ),
            ( "pagebutton", BUTTONPOS_PAGES, num_button_pages() >= 2 ) ):
        ios[part] = []
        if needed:
            b = button_register(position)
            ios["buttons"].remove(b)
            ios[part].append(b)

    # With two lucky buttons they sit next to each other in the third
    # row, and the arpeggiator moves one place up.
    ios["luckybuttons"] = []
    if have_two_lucky_buttons():
        for number in ( BUTTONPOS_LUCKY - 1, BUTTONPOS_LUCKY ):
            b = button_register(number)
            ios["buttons"].remove(b)
            ios["luckybuttons"].append(b)

    # The start/stop button always sits next to the reset button, so
    # its place is reserved before any feature can take it.
    ios["startbutton"] = []
    if arguments["ssb"]:
        b = button_register(BUTTONPOS_STARTSTOP)
        ios["buttons"].remove(b)
        ios["startbutton"].append(b)

    # With two B32s the track buttons get their own block on the second
    # one. Reserve them here so that no optional feature can take them.
    if num_b32() > 1 and arguments["tracks"] > 1:
        for t in range(arguments["tracks"]):
            b = button_register(BUTTONPOS_TRACKS_2ND_B32 + t)
            ios["buttons"].remove(b)
            ios["trackbuttons"].append(b)

    if arguments["cn"] == "p":
        ios["pots"] = [ "P1.1", "P1.2" ]
        ios["encoders"] = []
    elif arguments["cn"] == "d":
        ios["pots"] = []
        ios["encoders"] = [ 1 ]
    else: # arguments["cn"] == "pd":
        ios["pots"] = [ "P2.1", "P2.2" ]
        ios["encoders"] = []

    if arguments["m"] in [ "master", "master+x7", "master18" ]:
        ios["cvouts"] += [ "O1", "O2", "O3", "O4", "O5", "O6", "O7", "O8" ]

    if arguments["m"] in [ "master", "master+x7"] :
        ios["cvins"] += [ "I1", "I2", "I3", "I4", "I5", "I6", "I7", "I8" ]

    if arguments["m"] == "master18":
        ios["gateins"] += [ "I1", "I2" ]
        ios["gateouts"] += [ "G1.1", "G1.2", "G1.3", "G1.4" ]

    if arguments["m"] == "master+x7":
        ios["gateouts"] += [ "G9", "G10", "G11", "G12" ]

    for g in range(arguments["g8"]):
        if arguments["m"] == "master18":
            gnum = g + 2
        else:
            gnum = g + 1
        ios["gateinouts"] += [ "G%d.%d" % (gnum, n) for n in [ 1, 3, 5, 7, 2, 4, 6, 8 ] ]


def track_is_midi(track):
    return arguments["t%dout" % track] != "cvgate" or \
        arguments["dualout"] >= track

def track_is_cvgate(track):
    t = arguments["t%dout" % track]
    if t == "cvgate" and arguments["dualout"] >= track:
        bail_out("You have set the number of tracks with\n"
                 "output to both MIDI and CV / gate to %d\n"
                 "but track %d is not set to MIDI. Please\n"
                 "set track %d to one of the MIDI output\n"
                 "options." % (arguments["dualout"], track, track))

    return t == "cvgate" or arguments["dualout"] >= track

